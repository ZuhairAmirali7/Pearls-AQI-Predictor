# ---------------------------------------------------------------------------
# Pearls AQI Predictor — example environment file.
# Copy to `.env` and fill in values. NEVER commit a real `.env`.
# Every variable here is also documented in README.md and docs/deployment.md.
# ---------------------------------------------------------------------------

# --- Application ---
APP_ENV=development
LOG_LEVEL=INFO
# Path to the YAML config file (defaults to config/config.yaml, falls back to
# config/config.example.yaml if that does not exist).
PEARLS_CONFIG_PATH=config/config.yaml

# --- Default location (overrides config.yaml when set) ---
DEFAULT_CITY=Karachi
DEFAULT_COUNTRY=Pakistan
DEFAULT_LATITUDE=24.8607
DEFAULT_LONGITUDE=67.0011
DEFAULT_TIMEZONE=Asia/Karachi

# --- Data providers ---
# Options: openmeteo (default, no key required) | openweather | sample
AQI_PROVIDER=openmeteo
WEATHER_PROVIDER=openmeteo
# Only required when *_PROVIDER=openweather
OPENWEATHER_API_KEY=

# --- Feature store ---
# Options: local (Parquet, default) | hopsworks
FEATURE_STORE_BACKEND=local
# Directory used by the local Parquet feature store.
LOCAL_FEATURE_STORE_DIR=data/local/feature_store
HOPSWORKS_API_KEY=
HOPSWORKS_PROJECT=

# --- Model registry ---
# Options: local (filesystem, default) | hopsworks
MODEL_REGISTRY_BACKEND=local
LOCAL_MODEL_REGISTRY_DIR=artifacts/models

# --- Alerts ---
ALERTS_ENABLED=false
ALERT_EMAIL_TO=
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
# Optional generic webhook (e.g. Slack incoming webhook)
ALERT_WEBHOOK_URL=

# --- API / dashboard wiring ---
# Base URL the Streamlit dashboard uses to reach the FastAPI backend.
# When unset the dashboard falls back to calling the library directly (no HTTP).
PEARLS_API_BASE_URL=
